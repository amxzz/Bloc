# ====================================================================
# SUPABASE CONFIGURATION FOR BLOC. GELATO ERP
# Copy this file to .env.local and fill in your Supabase project values
# ====================================================================

# 1. Open https://supabase.com and create a free project (e.g., system-bloc-gelato)
# 2. Go to Project Settings -> API
# 3. Copy Project URL and paste it below:
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# 4. Copy anon / public / publishable API key and paste it below:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here
